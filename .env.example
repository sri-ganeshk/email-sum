# ============================================================
# BACKEND (copy to backend/.env)
# ============================================================
NODE_ENV=development
PORT=4000

# Google OAuth 2.0 — from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/callback

# Must be ≥32 chars — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_32_char_random_string

FRONTEND_URL=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000

# HuggingFace Inference API
HF_API_TOKEN=your_huggingface_api_token_here
HF_API_URL=https://api-inference.huggingface.co/models/mistralai/Mistral-7B-Instruct-v0.2

# ============================================================
# FRONTEND (copy to frontend/.env.local — prefix with VITE_)
# ============================================================
VITE_API_URL=http://localhost:4000
VITE_APP_NAME=AI Email Assistant

# ============================================================
# ML SERVICE (copy to ml-service/.env)
# ============================================================
MODEL_NAME=sshleifer/distilbart-cnn-12-6
ML_SERVICE_API_KEY=replace_with_32_char_random_string
HF_HOME=/app/.cache/huggingface
